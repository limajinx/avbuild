--disable-autodetect
--disable-doc
--disable-debug
--disable-programs
--disable-static
--enable-shared
--enable-small
--enable-pic
--enable-runtime-cpudetect
--disable-avdevice
--disable-encoders
--disable-muxers
--disable-decoders
--disable-demuxers
--disable-parsers
--disable-filters
--disable-protocols
--disable-hwaccels
--enable-jni
--enable-mediacodec
--enable-zlib
--enable-wolfssl
--enable-libdav1d
--enable-decoder=webp*,aac*,ac3*,eac3*,alac*,amr*,ape,apv,av1*,cfhd,cook,dca,dnxhd,exr,truehd,*yuv*,flv,flac,gif,h26[3-4]*,hevc*,hap,mp[1-3]*,prores*,*[mj]peg*,mlp,mss*,nellymoser,opus,pcm*,qtrle,*png*,tiff,rawvideo,rv[1-4]*,v210*,vc1*,vorbis,vp[6-9]*,wm*,wrapped_avframe,libdav1d
--enable-demuxer=mov,hls,mpegts,flv,matroska,aac
--enable-parser=h264,hevc,aac,aac_latm,av1,vp8,vp9,opus,vorbis
--enable-filter=buffer,buffersink,abuffer,abuffersink,null,anull,format,aformat,scale,aresample,atempo,volume
--enable-protocol=file,http,https,tcp,tls,crypto
